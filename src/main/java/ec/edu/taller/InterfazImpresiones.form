                <properties>
                  <font size="14" style="1"/>
                  <text value="DOCUMENTO"/>
                </properties>
              </component>
              <component id="ges07" class="javax.swing.JLabel" binding="lblValorDocumento">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="*"/>
                </properties>
              </component>
              <component id="ges08" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="14" style="1"/>
                  <text value="PRIORIDAD"/>
                </properties>
              </component>
              <component id="ges09" class="javax.swing.JLabel" binding="lblValorPrioridad">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="*"/>
                </properties>
              </component>
              <component id="ges10" class="javax.swing.JLabel">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="14" style="1"/>
                  <text value="ESTADO"/>
                </properties>
              </component>
              <component id="ges11" class="javax.swing.JLabel" binding="lblValorEstado">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="*"/>
                </properties>
              </component>
              <component id="ges12" class="javax.swing.JLabel">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="12" style="1"/>
                  <text value="TRABAJOS PENDIENTES (ORDENADOS: MENOR VALOR = MAYOR PRIORIDAD)"/>
                </properties>
              </component>
              <scrollpane id="ges13">
                <constraints>
                  <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="570" height="170"/>
                  </grid>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="ges14" class="javax.swing.JTextArea" binding="txtPendientes">
                    <constraints/>
                    <properties>
                      <editable value="false"/>
                      <font name="Monospaced" size="12"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
              <grid id="ges15" binding="panelInferior" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="40" vgap="8">
                <margin top="10" left="10" bottom="0" right="10"/>
                <constraints>
                  <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="ges16" class="javax.swing.JLabel" binding="lblPendientes">
