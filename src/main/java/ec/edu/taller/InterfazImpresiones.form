                    </constraints>
                    <properties>
                      <font size="14" style="1"/>
                      <text value="DISPONIBLES: 10"/>
                    </properties>
                  </component>
                  <component id="ges18" class="javax.swing.JLabel" binding="lblCapacidad">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <font size="14" style="1"/>
                      <text value="CAPACIDAD: 10"/>
                    </properties>
                  </component>
                  <component id="ges19" class="javax.swing.JButton" binding="btnProcesar">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                        <preferred-size width="230" height="34"/>
                      </grid>
                    </constraints>
                    <properties>
